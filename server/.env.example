# PR Pilot Server — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ============================================================================
# Required
# ============================================================================

# GitHub personal access token with 'repo' scope (to post PR comments)
GITHUB_TOKEN=your_github_token_here

# GitHub repository in owner/repo format
GITHUB_REPO=your-org/your-repo

# GitHub webhook secret — must match the secret set in GitHub Settings > Webhooks
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# Optional
# ============================================================================

# Path to the bob CLI executable (default: bob, assumes it's in PATH)
BOB_SHELL_PATH=bob

# IBM Bob API key (if required by your Bob installation)
# BOB_API_KEY=your_bob_api_key_here

# Server port (default: 3000)
PORT=3000

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# Logging level: error | warn | info | http | debug (default: info)
LOG_LEVEL=info
