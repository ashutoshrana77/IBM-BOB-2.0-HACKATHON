{
  "name": "pr-pilot-server",
  "version": "1.0.0",
  "description": "PR Pilot webhook server — receives GitHub PR events and triggers IBM Bob reviews",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --testEnvironment=node --forceExit",
    "test:coverage": "jest --coverage --testEnvironment=node --forceExit",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
